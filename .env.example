# Grafana Cloud Frontend Observability (Faro) collector URL. Leave empty in dev: Faro stays off.
VITE_FARO_URL=

# Supabase project URL and publishable (anon) key. Safe in the browser; never put the secret/service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Show the "Continue with Google" button on the sign-in screen. Leave unset: sign-in is by email link only.
# VITE_AUTH_GOOGLE=true

# Source map upload (set only in the Cloudflare Pages build environment, never commit real values)
# FARO_SOURCEMAP_ENDPOINT=
# FARO_SOURCEMAP_API_KEY=
# FARO_APP_ID=
# FARO_STACK_ID=
